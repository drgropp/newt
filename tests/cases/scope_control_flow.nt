mut count = 0;

while count < 5 {
    count = count + 1;
    let iteration = count;

    if count == 2 {
        let skipped = 200;
        continue;
    }

    print iteration;
    if count == 3 {
        let stopped = 300;
        break;
    }
}

print count;

fn early_return() {
    if true {
        let answer = 7;
        return answer;
    }
    return 0;
}

