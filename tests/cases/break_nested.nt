mut outer = 0;
mut inner = 0;

while true {
    outer = outer + 1;
    inner = 0;

    while true {
        inner = inner + 1;
        if inner == 2 {
            break;
            print "unreachable inner";
        }
    }

    print text(outer) + ":" + text(inner);
    if outer == 3 {
        break;
        print "unreachable outer";
    }
}

print "done";
